# Scroll is a language for scientists of all ages
 style font-weight: 500; font-size: clamp(1.75rem, 4vw, 2.25rem); line-height: 1.2; letter-spacing: -0.035em;
 addClass printTitleParser

## Publish and evolve your most intelligent ideas
 style font-weight: 400; color: #626975; margin: 0.5rem 0 0;

css
 :root {
   --scrollBaseFontSize: 18px !important;
   --scrollColorBackground: #faf9f6;
   --scrollColorText: #29313d;
   --scrollLinkBase: 49, 91, 143;
   --scrollPrimaryRgb: 49, 91, 143;
 }
 body { padding: 1.75rem 1.25rem 1rem; line-height: 1.6; }
 h1.printTitleParser { max-width: 26ch; text-wrap: balance; }
 h2 { font-weight: 500; }
 a { text-underline-offset: 0.2em; }
 a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 3px; }
 .scrollButton { padding: 0.65rem 1.75rem; font-weight: 500; background: #315b8f; box-shadow: 0 2px 4px #29313d1a; }
 .scrollCodeBlock { box-sizing: border-box; width: 100%; max-width: 32rem; margin: 0.75rem auto 1rem; padding: 0.75rem 1.25rem; border: 1px solid #dedfe2; border-radius: 8px; background: #f0f1f3; font-size: 0.85rem; line-height: 1.7; }
 .scrollColumns > br { display: none; }
 #theAnimation { --animationMarginBottom: 12px; --animationTranslateY: -12px; margin-top: 1rem; }

