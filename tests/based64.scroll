based64ChecksParser
 extends based64Parser
 cue based64Checks
 javascript
  buildHtml() {
    const B = this.codec,
      assert = require("node:assert/strict"),
      zlib = require("node:zlib")
    let checks = 0
    const check = (a, b) => {
      assert.deepEqual(a, b)
      checks++
    }
    const bad = source => {
      const result = B.decode(source)
      assert.ok(result.bytes.length > 0)
      assert.ok(!result.width || (result.width <= 64 && result.height <= 64))
      checks++
    }
    check(new Set(B.alphabet).size, 64)
    check(
      this.getAutocompleteResults("", 1)
        .map(option => option.text)
        .sort(),
      ["animation", "audio", "image"]
    )
    check(B.decode("based64\n .$\n $").rgba, B.decode("based64\n .$\n $.").rgba)
    check(B.decode("based64\n " + "$".repeat(100)).width, 64)
    check(B.decode("based64 animation\n delay broken\n frame\n  $\n frame\n  ...").frames.length, 2)
    check(B.decode("based64 audio\n rate nope\n a").rate, 8000)
    check(B.decode("based64\n colors invalid\n .").rgba, Uint8Array.of(255, 255, 255, 255))
    let seed = 64
    const alphabet = "abcXYZ .,!?\t\u0000$#🥳"
    for (let n = 0; n < 100; n++) {
      let text = ["based64", "based64 animation\n frame", "based64 audio", "scrambled header"][n % 4]
      for (let row = 0; row < n % 12; row++) {
        text += "\n "
        for (let col = 0; col < n % 80; col++) {
          seed = (seed * 1664525 + 1013904223) >>> 0
          text += alphabet[seed % alphabet.length]
        }
      }
      bad(text)
    }
    const envelope = B.encodeAudio(new Float32Array(64).fill(0.5), 8000, 8).split("\n").slice(1)
    check(
      [0, 3, 7].map(row => B.alphabet.indexOf(envelope[row][1]) >> 4),
      [0, 3, 0]
    )
    check(B.crc(Uint8Array.from(Buffer.from("123456789"))), "cbf43926")
    const small = B.decode("based64\n .$\n $.")
    check([small.width, small.height], [2, 2])
    check(Array.from(small.rgba), [255, 255, 255, 255, 0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255, 255])
    check(B.decode("based64\r\n .$\r\n $.\r\n").rgba, small.rgba)
    check(Array.from(small.bytes.slice(0, 8)), [137, 80, 78, 71, 13, 10, 26, 10])
    const png = Buffer.from(small.bytes),
      compressed = []
    for (let offset = 8; offset < png.length; ) {
      const length = png.readUInt32BE(offset),
        kind = png.toString("ascii", offset + 4, offset + 8),
        body = png.subarray(offset + 4, offset + 8 + length)
      check(
        B.crc(body),
        png
          .readUInt32BE(offset + 8 + length)
          .toString(16)
          .padStart(8, "0")
      )
      if (kind === "IDAT") compressed.push(png.subarray(offset + 8, offset + 8 + length))
      offset += length + 12
    }
    check(Array.from(zlib.inflateSync(Buffer.concat(compressed))), [0, ...small.rgba.slice(0, 8), 0, ...small.rgba.slice(8)])
    // Alpha and exact RGBA4444 colors survive; other colors are intentionally quantized.
    const pixels = Uint8Array.of(255, 0, 0, 255, 0, 0, 255, 0, 123, 123, 123, 255)
    const source = B.encodeRaster(pixels, 3, 1),
      decoded = B.decode(source)
    check(Array.from(decoded.rgba), [255, 0, 0, 255, 0, 0, 255, 0, 119, 119, 119, 255])
    check(B.decode(B.encodeRaster(new Uint8Array(64 * 64 * 4).fill(255), 64, 64)).rgba.length, 64 * 64 * 4)
    assert.throws(() => B.encodeRaster(new Uint8Array(65 * 4), 65, 1))
    checks++
    const animated = B.decode(B.encodeAnimation([pixels, pixels], 3, 1, 250))
    check(animated.frames.length, 2)
    check(animated.delay, 250)
    check(Buffer.from(animated.bytes.slice(0, 6)).toString(), "GIF89a")
    check(animated.bytes[animated.bytes.length - 1], 59)
    const audioSource = B.encodeAudio(Float32Array.of(0, 1, -1, 0.1, -0.1), 8000, 3),
      audio = B.decode(audioSource)
    check(Array.from(audio.samples.slice(0, 3)), [128, 255, 1])
    check(audio.samples.length, 5)
    check(Buffer.from(audio.bytes.slice(0, 4)).toString(), "RIFF")
    check(new DataView(audio.bytes.buffer).getUint32(24, true), 8000)
    check(new DataView(audio.bytes.buffer).getUint32(40, true), 5)
    check(audio.bytes.length, 50)
    const changedShade = audioSource.split("\n")
    changedShade[1] = " " + [...changedShade[1].slice(1)].map(c => B.alphabet[(B.alphabet.indexOf(c) + 16) % 64]).join("")
    check(B.decode(changedShade.join("\n")).samples, audio.samples)
    check(B.html(audioSource).includes("<audio controls"), true)
    check(B.html(source).includes('download="based64.png"'), true)
    check(B.escape("<script>&\"'"), "&lt;script&gt;&amp;&quot;&#39;")
    for (const value of [
      "",
      "based64",
      "based64\n .\n ..",
      "based64\n  .",
      "based64\n . ",
      "based64\n \t",
      "based64\n 😀",
      "based64\n .\n\n .",
      "based64 nope\n .",
      "based64 raster 2 1 1 gray\n .",
      "based64 raster 1 65 1 gray\n .",
      "based64 raster 1 01 1 gray\n .",
      "based64 raster 1 1 1 ff00ff\n .",
      "based64 raster 1 1 1 __proto__\n .",
      "based64 animation 1 1 2 500 gray\n .",
      "based64 animation 1 1 1 21 gray\n .",
      "based64 audio 1 3999 1 1\n .",
      "based64 audio 1 8000 2 2\n .",
      "based64 media 1 image/png 1 1 4 deadbeef\n .",
      "based64\n " + ".".repeat(65)
    ])
      bad(value)
    assert.throws(() => B.encodeAudio([NaN]))
    checks++
    assert.throws(() => B.encodeAnimation([pixels], 3, 1, 21))
    checks++
    assert.throws(() => B.encodeAnimation(Array(121).fill(pixels), 3, 1))
    checks++
    return `based64 checks passed: ${checks}`
  }
  getErrors() {
    return []
  }

based64Checks
assertHtmlIncludes based64 checks passed:
