        str(0, "RIFF")
        view.setUint32(4, bytes.length - 8, true)
        str(8, "WAVEfmt ")
        view.setUint32(16, 16, true)
        view.setUint16(20, 1, true)
        view.setUint16(22, 1, true)
        view.setUint32(24, rate, true)
        view.setUint32(28, rate, true)
        view.setUint16(32, 1, true)
        view.setUint16(34, 8, true)
        str(36, "data")
        view.setUint32(40, samples.length, true)
        bytes.set(samples, 44)
        return bytes
      }
      static sample(code) {
        const magnitude = (Math.pow(256, (code & 7) / 7) - 1) / 255
        return code & 8 ? -magnitude : magnitude
      }
      static decode(source) {
        // Editing is always renderable. Bound work, repair metadata, and pad/crop the drawing.
        const lines = String(source ?? "")
          .slice(0, 3 * this.maxPixels + 10000)
          .replace(/\r\n?/g, "\n")
          .replace(/\n$/, "")
          .split("\n")
        const header = /^based64(?:\s|$)/.test(lines[0]) ? lines.shift().trim().split(/\s+/) : []
        const mode = header[1] === "audio" ? "audio" : header[1] === "animation" ? "animation" : "image"
        let colors = this.palette("gray"),
          delay = 500,
          rate = 8000
        const groups = [[]]
        const number = (value, fallback, min, max) => (Number.isFinite(Number(value)) && String(value).trim() !== "" ? Math.min(max, Math.max(min, Math.round(Number(value)))) : fallback)
        for (const raw of lines.slice(0, mode === "audio" ? this.maxPixels : 8000)) {
          const line = raw.replace(/^ /, "")
          if (/^colors(?:\s|$)/.test(line)) {
            const hexes = line
              .slice(6)
              .trim()
              .split(/[\s,]+/)
              .filter(hex => /^[0-9a-f]{6}([0-9a-f]{2})?$/i.test(hex))
              .slice(0, 64)
            colors = hexes.length ? this.palette(hexes.map(hex => hex.toLowerCase() + (hex.length === 6 ? "ff" : "")).join(",")) : this.palette("gray")
          } else if (/^delay(?:\s|$)/.test(line)) delay = Math.round(number(line.slice(5), 500, 20, 10000) / 10) * 10
          else if (/^rate(?:\s|$)/.test(line)) rate = number(line.slice(4), 8000, 4000, 16000)
          else if (mode === "animation" && line.trim() === "frame") {
            if (groups[groups.length - 1].length || groups.length > 1) groups.push([])
          } else groups[groups.length - 1].push(mode === "animation" ? line.replace(/^ /, "") : line)
        }
        const index = c => {
          if (/\s/.test(c)) return 0
          const known = this.alphabet.indexOf(c)
          return known === -1 ? c.codePointAt(0) % 64 : known
        }
        if (mode === "audio") {
          const text = groups.flat().join("").slice(0, this.maxPixels) || "."
          const samples = Uint8Array.from(text, c => Math.round(128 + 127 * this.sample(index(c) & 15)))
          return { mime: "audio/wav", bytes: this.wav(samples, rate), rows: groups.flat(), samples, rate }
        }
        const selected = (mode === "animation" ? groups.slice(0, 120) : [groups[0]]).map(rows => rows.slice(0, 64).map(row => Array.from(row).slice(0, 64)))
        const width = Math.max(1, ...selected.flat().map(row => row.length)),
          height = Math.max(1, ...selected.map(rows => rows.length))
        const frames = selected.map(rows => Uint8Array.from({ length: width * height }, (_, i) => index(rows[Math.floor(i / width)]?.[i % width] || ".")))
        const rgba = new Uint8Array(width * height * 4)
        frames[0].forEach((value, i) => rgba.set(colors[Math.round((value * (colors.length - 1)) / 63)], i * 4))
        const rows = selected[0].map(row => row.join(""))
        return mode === "animation" ? { mime: "image/gif", bytes: this.gif(width, height, frames, colors, delay), width, height, frames, rows, delay } : { mime: "image/png", bytes: this.png(width, height, rgba), width, height, rgba, rows }
      }
      static encodeAudio(samples, rate = 8000, width = 64) {
        this.integer(rate, 4000, 16000)
        this.integer(width, 1, 64)
        this.check(samples.length > 0 && samples.length <= this.maxPixels && Array.from(samples).every(Number.isFinite), "invalid audio samples")
        // Each glyph carries one 4-bit logarithmic PCM sample. Its high two bits draw a waveform.
        const peaks = new Float32Array(width),
          tileHeight = Math.min(32, Math.ceil(samples.length / width))
        for (let x = 0; x < width; x++) {
          const start = Math.floor((x * samples.length) / width),
            end = Math.floor(((x + 1) * samples.length) / width)
          for (let i = start; i < end; i++) peaks[x] = Math.max(peaks[x], Math.min(1, Math.abs(samples[i])))
        }
        let out = "based64 audio" + (rate === 8000 ? "" : `\n rate ${rate}`)
        for (let i = 0; i < samples.length; i++) {
          const value = Math.max(-1, Math.min(1, samples[i]))
          const code = (value < 0 ? 8 : 0) + Math.round((Math.log1p(255 * Math.abs(value)) / Math.log(256)) * 7)
          const y = tileHeight === 1 ? 0 : ((Math.floor(i / width) % tileHeight) / (tileHeight - 1)) * 2 - 1
          const group = Math.abs(y) <= peaks[i % width] ? 3 : 0
          if (i % width === 0) out += "\n "
          out += this.alphabet[group * 16 + code]
        }
        return out
      }
      static encodeAnimation(frames, width, height, delay = 500) {
