  }
  get codec() {
    return this.constructor.createCodec()
  }
  get source() {
    return (
      this.getLine() +
      "\n" +
      this.subparticlesToString()
        .split("\n")
        .map(line => " " + line)
        .join("\n")
    )
  }
  getErrors() {
    const errors = super.getErrors().filter(error => !(this.atoms.length === 1 && error.toObject().type === "MissingAtom" && error.toObject().atom === 1))
    try {
      this.codec.decode(this.source)
    } catch (error) {
      errors.push(this.makeError(error.message))
    }
    return errors
  }
  buildHtml() {
    return this.codec.html(this.source)
  }
  buildTxt() {
    return this.source
  }

based64StudioParser
 extends based64Parser
 cue based64Studio
 description Simplify local media into visual text.
 javascript
  static async studio(element, B) {
    element.innerHTML = `<p><label>Choose file <input type="file" accept="image/*,video/*,audio/*"></label></p><details><summary>Advanced settings</summary><p><label>Maximum edge <input class="edge" type="number" min="8" max="64" value="64"></label> <label>Start (seconds) <input class="start" type="number" min="0" value="0"></label> <label>Clip (seconds) <input class="duration" type="number" min="1" max="10" value="4"></label> <label>Frames/second <select class="fps"><option>1</option><option selected>2</option><option>4</option><option>8</option></select></label></p><button class="save">Save text</button></details><p role="status"></p><textarea aria-label="based64 source" placeholder="Choose a file, or draw here…" spellcheck="false" rows="20" style="box-sizing:border-box;width:100%;white-space:pre;overflow:auto;font:12px/1 monospace;background:white;color:black"></textarea><div class="result"></div>`
    const $ = selector => element.querySelector(selector),
      status = $("[role=status]"),
      text = $("textarea"),
      result = $(".result")
    const report = error => {
      status.textContent = error.message
    }
    const render = () => {
      const decoded = B.decode(text.value)
      result.innerHTML = B.html(text.value, false)
      status.textContent = `${decoded.width ? decoded.width + "×" + decoded.height + " · " : ""}${text.value.length.toLocaleString()} characters. Edit the text to change the result.`
    }
    let revision = 0,
      timer
    text.oninput = () => {
      revision++
      clearTimeout(timer)
      timer = setTimeout(render, 100)
    }
    $(".save").onclick = () => {
      try {
        B.decode(text.value)
        const url = URL.createObjectURL(new Blob([text.value + "\n"], { type: "text/plain" }))
        const link = document.createElement("a")
        link.href = url
        link.download = "based64.scroll"
        link.click()
        setTimeout(() => URL.revokeObjectURL(url), 1000)
      } catch (error) {
        report(error)
      }
    }
    const event = (target, name, action) =>
      new Promise((resolve, reject) => {
        const cleanup = () => {
          clearTimeout(timer)
          target.removeEventListener(name, done)
          target.removeEventListener("error", fail)
        }
        const done = () => {
            cleanup()
            resolve()
          },
          fail = () => {
            cleanup()
            reject(new Error("Browser could not decode this media"))
          }
        const timer = setTimeout(() => {
          cleanup()
          reject(new Error("Media preview timed out"))
        }, 15000)
        target.addEventListener(name, done, { once: true })
        target.addEventListener("error", fail, { once: true })
        try {
          action()
        } catch (error) {
          cleanup()
          reject(error)
        }
      })
    const encode = async () => {
      const request = ++revision
      clearTimeout(timer)
      if (!$("input[type=file]").files[0]) return
      let url, media, context, decoder
      try {
        const file = $("input[type=file]").files[0]
        B.check(file && file.size > 0 && file.size <= B.maxBytes, "choose a file of 1 byte to 20 MiB")
        const mime = file.type || { gif: "image/gif", png: "image/png", jpg: "image/jpeg", mp4: "video/mp4", wav: "audio/wav", mp3: "audio/mpeg" }[file.name.split(".").pop().toLowerCase()]
        B.check(mime && /^(image|audio|video)\//.test(mime), "choose an image, video, or audio file")
        const edge = B.integer($(".edge").value, 8, 64),
          start = Number($(".start").value),
          duration = B.integer($(".duration").value, 1, 10),
          fps = Number($(".fps").value)
        B.check(Number.isFinite(start) && start >= 0, "start must be nonnegative")
        status.textContent = "Simplifying media locally…"
        const bytes = new Uint8Array(await file.arrayBuffer())
        const canvas = document.createElement("canvas"),
          ctx = canvas.getContext("2d", { willReadFrequently: true })
        const size = (w, h) => {
          const scale = Math.min(1, edge / Math.max(w, h))
          canvas.width = Math.max(1, Math.round(w * scale))
          canvas.height = Math.max(1, Math.round(h * scale))
        }
        const draw = frame => {
          ctx.clearRect(0, 0, canvas.width, canvas.height)
          ctx.drawImage(frame, 0, 0, canvas.width, canvas.height)
          return ctx.getImageData(0, 0, canvas.width, canvas.height).data
        }
        let source
        if (mime.startsWith("audio/")) {
          context = new AudioContext()
          const audio = await context.decodeAudioData(bytes.buffer.slice(0))
          B.check(start < audio.duration, "start is past the end of the audio")
          const length = Math.max(1, Math.floor(Math.min(duration, audio.duration - start) * 8000))
          const offline = new OfflineAudioContext(1, length, 8000),
            node = offline.createBufferSource()
          node.buffer = audio
          node.connect(offline.destination)
          node.start(0, start)
          const downsampled = await offline.startRendering()
          source = B.encodeAudio(downsampled.getChannelData(0), 8000, 64)
        } else if (mime === "image/gif") {
          B.check(typeof ImageDecoder !== "undefined" && (await ImageDecoder.isTypeSupported(mime)), "Animated GIF sampling requires ImageDecoder (try Chrome); convert the source to MP4 otherwise")
          decoder = new ImageDecoder({ data: bytes, type: mime })
          await decoder.tracks.ready
          const track = decoder.tracks.selectedTrack,
            frames = []
          let time = 0,
            next = start,
            scanned = 0
          // Decode sequentially so disposal/compositing and variable source timing are respected.
          for (let i = 0; i < track.frameCount && next < start + duration; i++) {
            B.check(++scanned <= 600, "GIF has too many source frames; trim it first")
            const { image } = await decoder.decode({ frameIndex: i })
            try {
              if (!frames.length) size(image.displayWidth, image.displayHeight)
              const end = time + Math.max(0.01, (image.duration || 100000) / 1e6)
              while (next < end && next < start + duration) {
                frames.push(draw(image))
                next += 1 / fps
              }
              time = end
            } finally {
              image.close()
            }
          }
          B.check(frames.length, "start is past the end of the GIF")
          source = B.encodeAnimation(frames, canvas.width, canvas.height, Math.round(100 / fps) * 10)
        } else {
          url = URL.createObjectURL(file)
          media = document.createElement(mime.startsWith("image/") ? "img" : "video")
          media.preload = "auto"
          media.muted = true
          await event(media, media.tagName === "IMG" ? "load" : "loadeddata", () => {
            media.src = url
          })
          size(media.naturalWidth || media.videoWidth, media.naturalHeight || media.videoHeight)
          if (media.tagName === "VIDEO") {
            B.check(Number.isFinite(media.duration) && start < media.duration, "start is past the end or video duration is unavailable")
            const frames = [],
              end = Math.min(start + duration, media.duration)
            for (let t = start; t < end && frames.length < 80; t += 1 / fps) {
              if (Math.abs(media.currentTime - t) > 0.001)
                await event(media, "seeked", () => {
                  media.currentTime = t
                })
              frames.push(draw(media))
            }
            source = B.encodeAnimation(frames, canvas.width, canvas.height, Math.round(100 / fps) * 10)
          } else source = B.encodeRaster(draw(media), canvas.width, canvas.height)
        }
        if (request !== revision) return
        text.value = source
        render()
      } catch (error) {
        if (request === revision) report(error)
      } finally {
        if (media && media.tagName === "VIDEO") {
          media.pause()
          media.removeAttribute("src")
          media.load()
        }
        if (url) URL.revokeObjectURL(url)
        if (context) await context.close()
        if (decoder) decoder.close()
      }
    }
    $("input[type=file]").onchange = encode
    for (const selector of [".edge", ".start", ".duration", ".fps"]) $(selector).onchange = encode
  }
  getErrors() {
    return []
  }
  buildHtml() {
    const code = `(${this.constructor.studio.toString().replace(/^async studio/, "async function")})(document.currentScript.previousElementSibling, (${this.constructor.createCodec.toString().replace(/^createCodec/, "function")})())`
    return `<section class="based64Studio"></section><script>${code.replace(/<\/script/gi, "<\\/script")}</script>`
  }
  buildTxt() {
    return "based64Studio"
  }
