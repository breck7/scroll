  static createCodec() {
    // This class is also serialized into the studio: no Node-only dependencies.
    return class Based64 {
      static alphabet = ".'`^\",:Il!i<>~+_-?]}{1)(|\\/tfjrxuvczXYUJCLQ0Omwqpdbkhao*#W&8%B@$"
      static maxBytes = 20 * 1024 * 1024
      static maxPixels = 1024 * 1024
      static types = { "image/png": "png", "image/gif": "gif", "audio/wav": "wav" }
      static check(ok, message) {
        if (!ok) throw new Error("based64: " + message)
      }
      static integer(text, min, max) {
        this.check(/^(0|[1-9][0-9]*)$/.test(String(text)), "expected canonical integer")
        const n = Number(text)
        this.check(Number.isSafeInteger(n) && n >= min && n <= max, "integer out of range")
        return n
      }
      static crc(bytes) {
        let crc = 0xffffffff
        for (const byte of bytes) {
          crc ^= byte
          for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0)
        }
        return ((crc ^ 0xffffffff) >>> 0).toString(16).padStart(8, "0")
      }
      static escape(text) {
        return text.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]))
      }
      static base64(bytes) {
        const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        let out = ""
        for (let i = 0; i < bytes.length; i += 3) {
          const n = bytes[i] * 65536 + (bytes[i + 1] || 0) * 256 + (bytes[i + 2] || 0)
          out += alphabet[n >>> 18] + alphabet[(n >>> 12) & 63] + (i + 1 < bytes.length ? alphabet[(n >>> 6) & 63] : "=") + (i + 2 < bytes.length ? alphabet[n & 63] : "=")
        }
        return out
      }
      static join(parts) {
        const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0))
        let offset = 0
        for (const part of parts) {
          out.set(part, offset)
          offset += part.length
        }
        return out
      }
      static u32(n) {
        return Uint8Array.of(n >>> 24, n >>> 16, n >>> 8, n)
      }
      static png(width, height, rgba) {
        // PNG RGBA8, filter 0, zlib stored blocks. Deliberately portable, not a PNG optimizer.
        const scan = new Uint8Array(height * (width * 4 + 1))
        for (let y = 0; y < height; y++) scan.set(rgba.subarray(y * width * 4, (y + 1) * width * 4), y * (width * 4 + 1) + 1)
        const blocks = [Uint8Array.of(0x78, 0x01)]
        for (let i = 0; i < scan.length; i += 65535) {
          const block = scan.subarray(i, i + 65535),
            n = block.length
          blocks.push(Uint8Array.of(i + n === scan.length ? 1 : 0, n & 255, n >>> 8, ~n & 255, (~n >>> 8) & 255), block)
        }
        let a = 1,
          b = 0
        for (const byte of scan) {
          a = (a + byte) % 65521
          b = (b + a) % 65521
        }
        blocks.push(this.u32((b * 65536 + a) >>> 0))
        const chunk = (type, data) => {
          const body = this.join([Uint8Array.from(type, c => c.charCodeAt(0)), data])
          return this.join([this.u32(data.length), body, this.u32(parseInt(this.crc(body), 16))])
        }
        return this.join([Uint8Array.of(137, 80, 78, 71, 13, 10, 26, 10), chunk("IHDR", this.join([this.u32(width), this.u32(height), Uint8Array.of(8, 6, 0, 0, 0)])), chunk("IDAT", this.join(blocks)), chunk("IEND", new Uint8Array())])
      }
      static palette(spec) {
        if (spec === "gray")
          return Array.from({ length: 64 }, (_, i) => {
            const n = Math.round(255 * (1 - i / 63))
            return [n, n, n, 255]
          })
        const colors = spec.split(",").map(hex => {
          this.check(/^[0-9a-f]{8}$/.test(hex), "palette colors must be lowercase RRGGBBAA")
          return [0, 2, 4, 6].map(i => parseInt(hex.slice(i, i + 2), 16))
