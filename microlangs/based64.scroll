        this.integer(height, 1, 64)
        this.integer(delay, 20, 10000)
        this.check(delay % 10 === 0 && frames.length > 0 && frames.length <= 120 && width * height * frames.length <= this.maxPixels, "invalid animation size or delay")
        this.check(
          frames.every(frame => frame.length === width * height * 4),
          "frame size mismatch"
        )
        const raster = this.rasterText(this.join(frames), width, height * frames.length)
        const lines = raster.split("\n")
        lines.shift()
        const palette = lines.shift()
        let out = "based64 animation\n" + palette + (delay === 500 ? "" : `\n delay ${delay}`)
        for (let frame = 0; frame < frames.length; frame++)
          out +=
            "\n frame\n" +
            lines
              .slice(frame * height, (frame + 1) * height)
              .map(line => " " + line)
              .join("\n")
        return out
      }
      static encodeRaster(rgba, width, height) {
        this.integer(width, 1, 64)
        this.integer(height, 1, 64)
        return this.rasterText(rgba, width, height)
      }
      static rasterText(rgba, width, height) {
        this.integer(width, 1, 64)
        this.integer(height, 1, 7680)
        this.check(width * height <= this.maxPixels && rgba.length === width * height * 4, "invalid raster")
        // Keep the 64 most frequent RGBA4444 colors, then nearest-color quantize.
        const histogram = new Map()
        for (let i = 0; i < rgba.length; i += 4) {
          const color = Array.from(rgba.slice(i, i + 4), n => Math.round(n / 17) * 17)
          const key = color.join(",")
          histogram.set(key, (histogram.get(key) || 0) + 1)
        }
        const darkness = c => 1 - (((0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) * c[3]) / 255 + 255 - c[3]) / 255
        const palette = [...histogram]
          .sort((a, b) => b[1] - a[1])
          .slice(0, 64)
          .map(([key]) => key.split(",").map(Number))
          .sort((a, b) => darkness(a) - darkness(b))
        // Spread small palettes over all 64 glyphs, retaining recognizable light/dark extremes.
        const colors = palette
        let out = `based64\n colors ${colors.map(c => c.map(n => n.toString(16).padStart(2, "0")).join("")).join(" ")}`
        const cache = new Map()
        for (let i = 0; i < width * height; i++) {
          const pixel = Array.from(rgba.slice(i * 4, i * 4 + 4)),
            key = pixel.join(",")
          let best = cache.get(key)
          if (best === undefined) {
            let distance = Infinity
            colors.forEach((color, index) => {
              const d = color.reduce((sum, n, j) => sum + (n - pixel[j]) ** 2, 0)
              if (d < distance) {
                distance = d
                best = index
              }
