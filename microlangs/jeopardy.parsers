// Jeopardy: A Microlang for Jeopardy boards, with sounds and scores.
// Sounds are from myinstants, re-encoded as mono MP3 and embedded as data URIs.
// Think Music: Final Jeopardy Thinking Music — https://www.myinstants.com/en/instant/final-jeopardy-thinking-music-31414/
// Daily Double: Daily-Double Theme Jeopardy — https://www.myinstants.com/en/instant/daily-double-theme-jeopardy-29935/
// Times Up: Jeopardy incorrect answer (the times-up buzzer) — https://www.myinstants.com/en/instant/jeopardy-incorrect-answer-16523/
// Correct: Jeopardy Correct Answer — https://www.myinstants.com/en/instant/jeopardy-correct-answer-52735/
// Board Fill: Jeopardy Board fill 2016 — https://www.myinstants.com/en/instant/jeopardy-board-fill-2016-75935/

jeopardyParser
 description A Jeopardy board with sounds and a 3-player scoreboard.
 extends abstractScrollParser
 cueFromId
 inScope h1Parser jeopardyAnswerParser jeopardyQuestionParser blankLineParser slashCommentParser
 example
  jeopardy
  # Science
  A: This element makes up about 78% of Earth's atmosphere
  Q: What is nitrogen?
 javascript
  buildHtml() {
      const categories = []
      let currentCategory = null
      let currentQuestions = []
      const content = this.root && this.root.toString ? this.root.toString() : this.toString()
      content.split('\n').forEach(line => {
        line = line.trim()
        if (line.startsWith('# ')) {
          if (currentCategory) categories.push({ name: currentCategory, questions: currentQuestions })
          currentCategory = line.slice(2).trim()
          currentQuestions = []
        } else if (line.startsWith('A:')) {
          currentQuestions.push({ question: line.slice(3).trim(), answer: '' })
        } else if (line.startsWith('Q:')) {
          if (currentQuestions.length) currentQuestions[currentQuestions.length - 1].answer = line.slice(3).trim()
        }
      })
      if (currentCategory) categories.push({ name: currentCategory, questions: currentQuestions })
      const escapeHtml = str => String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
      const boardId = 'jeopardy-' + (this.lineIndex || 1)
      const modalId = boardId + '-modal'
      const scoresId = boardId + '-scores'
      const soundId = boardId + '-sound'
      const columnCount = Math.max(categories.length, 1)
      const css = '@import url("https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap");'
        + 'body {background:#000033;margin:0;}'
        + '.scrollSection {display:none;}'
        + '.jeopardy-board {display:grid;grid-template-columns:repeat(' + columnCount + ',1fr);gap:4px;padding:10px 10px 130px;background:#000033;font-family:"Swiss 911", Helvetica, sans-serif;width:98vw;height:calc(100vh - 120px);max-width:1200px;margin:0 auto;box-sizing:border-box;}'
        + '.jeopardy-category {background:#000099;color:white;padding:4px;text-align:center;font-size:16px;display:flex;align-items:center;justify-content:center;text-transform:uppercase;}'
        + '.jeopardy-tile {background:#000099;color:#ffcc00;font-size:24px;padding:4px;text-align:center;cursor:pointer;min-height:0;display:flex;align-items:center;justify-content:center;transition:transform 0.2s;}'
        + '.jeopardy-tile:hover {transform:scale(1.02);}'
        + '.jeopardy-tile.answered {background:#000066;color:transparent;cursor:default;}'
        + '.jeopardy-modal {position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,51,0.95);display:none;align-items:center;justify-content:center;z-index:1000;cursor:pointer;}'
        + '.jeopardy-modal.active {display:flex;}'
        + '.jeopardy-modal-content {color:white;font-size:48px;text-align:center;max-width:80%;padding:40px;}'
        + '@keyframes slideIn {from {transform:translateY(-100%);opacity:0;} to {transform:translateY(0);opacity:1;}}'
        + '.jeopardy-modal.active .jeopardy-modal-content {animation:slideIn 0.5s ease-out;}'
        + '.jeopardy-dd {display:none;color:#ffcc00;font-size:28px;letter-spacing:0.12em;margin-bottom:16px;font-family:"Swiss 911", Helvetica, sans-serif;}'
        + '.jeopardy-clue {line-height:1.3;}'
        + '.jeopardy-score-actions {display:none;margin-top:28px;font-size:18px;cursor:default;}'
        + '.jeopardy-score-actions.active {display:flex;flex-wrap:wrap;justify-content:center;gap:20px;}'
        + '.jeopardy-score-player {background:#000099;border:2px solid #ffcc00;padding:10px 14px;min-width:140px;}'
        + '.jeopardy-score-player .jsb-name {display:block;font-family:"Permanent Marker", Caveat, cursive;font-size:22px;color:white;margin-bottom:8px;}'
        + '.jeopardy-score-player button {background:#000099;color:#ffcc00;border:2px solid #ffcc00;width:42px;height:42px;font-size:22px;margin:0 4px;cursor:pointer;}'
        + '.jeopardy-score-player button:hover {background:#ffcc00;color:#000099;}'
        + '.jeopardy-scores {position:fixed;bottom:0;left:0;right:72px;display:flex;justify-content:center;gap:16px;padding:10px 16px;background:#000033;z-index:900;}'
        + '.jeopardy-player {background:#000099;color:#ffcc00;min-width:150px;text-align:center;padding:8px 16px;border:2px solid #000099;}'
        + '.jeopardy-player-name {font-family:"Permanent Marker", Caveat, cursive;font-size:22px;color:white;outline:none;min-height:1.2em;}'
        + '.jeopardy-player-score {font-family:"Swiss 911", Helvetica, sans-serif;font-size:26px;color:#ffcc00;margin-top:2px;}'
        + '.jeopardy-sound {position:fixed;bottom:16px;right:16px;z-index:1100;background:#000099;color:#ffcc00;border:2px solid #ffcc00;width:48px;height:48px;font-size:24px;line-height:1;cursor:pointer;padding:0;}'
      let html = '<style>' + css + '</style>'
      html += '<div id="' + boardId + '" class="jeopardy-board">'
      categories.forEach(category => {
        html += '<div class="jeopardy-category">' + escapeHtml(category.name) + '</div>'
      })
      for (let value = 200; value <= 1000; value += 200) {
        const questionIndex = value / 200 - 1
        categories.forEach(category => {
          const item = category.questions[questionIndex]
          if (item) {
            html += '<div class="jeopardy-tile" data-question="' + escapeHtml(item.question) + '" data-answer="' + escapeHtml(item.answer) + '" data-value="' + value + '">$' + value + '</div>'
          } else {
            html += '<div class="jeopardy-tile answered"></div>'
          }
        })
      }
      html += '</div>'
      html += '<div id="' + modalId + '" class="jeopardy-modal"><div class="jeopardy-modal-content">'
      html += '<div class="jeopardy-dd">DAILY DOUBLE</div>'
      html += '<div class="jeopardy-clue"></div>'
      html += '<div class="jeopardy-score-actions"></div>'
      html += '</div></div>'
      html += '<div class="jeopardy-scores" id="' + scoresId + '">'
      for (let i = 0; i < 3; i++) {
        html += '<div class="jeopardy-player" data-player="' + i + '">'
        html += '<div class="jeopardy-player-name" contenteditable="true" spellcheck="false">Player ' + (i + 1) + '</div>'
        html += '<div class="jeopardy-player-score">$0</div>'
        html += '</div>'
      }
      html += '</div>'
      html += '<button type="button" class="jeopardy-sound" id="' + soundId + '" title="Sound">🔊</button>'
      const think = ''
        + 'data:audio/mpeg;base64,SUQzBAAAAAAARFRYWFgAAAAYAAADRW5jb2RlZCBieQBMYXZmNTIuMzEuMABUU1NFAAAADgAAA0xhdmY2My4xLjEwMQAAAAAAA'
        + 'AAAAAAA//NwwAAAAAAAAAAAAEluZm8AAAAPAAAEfwACwWcAAgUICg0QEhQXGhwfIiQnKSsuMTM2OTs9QEJFSEpNT1JUV1pcX2JjZmlrbnFzdnh6fYCChYiKj'
        + 'I+SlJeanJ6ho6apq66xsrW4ur3AwsTHyszP0tTX2dve4ePm6evt8PL1+Pr9AAAAAExhdmM2My4xLgAAAAAAAAAAAAAAACQDhAAAAAAAAsFnPk92GAAAAAAAA'
        + 'AAAAAAAAAD/82DEABvCBkgBSTAABAkYuc7XFYIAgGCRiEFEArFYrFYrRznOIMIEAAQQcwhEZ/dxEGECBDLIECBAhEZ+0REZ//3u7u4j+IiM//u7u4iIiIiLu'
        + '7u7u4jPd74Jk7f/5cEAQBDE4Pg+D7gQBCDgIf/wQBAEATB8H//+oEAQRFqbScidasaSaPSKpcYwMhEG8ag4VKGifzTOzqR4jXr/82LEICdiRopdj0gB5CVEj'
