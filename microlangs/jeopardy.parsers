        + 'VVVVVVVVVVVVVVVVVVVVVVVVQ=='
      html += '<script>'
      html += '(function() {'
      html += 'const board = document.getElementById("' + boardId + '");'
      html += 'const modal = document.getElementById("' + modalId + '");'
      html += 'const clueEl = modal.querySelector(".jeopardy-clue");'
      html += 'const ddEl = modal.querySelector(".jeopardy-dd");'
      html += 'const actionsEl = modal.querySelector(".jeopardy-score-actions");'
      html += 'const scoresEl = document.getElementById("' + scoresId + '");'
      html += 'const soundBtn = document.getElementById("' + soundId + '");'
      html += 'const sounds = {think:"' + think + '",dailyDouble:"' + dailyDouble + '",timesUp:"' + timesUp + '",correct:"' + correct + '",boardFill:"' + boardFill + '"};'
      html += 'let showingAnswer = false;'
      html += 'let currentTile = null;'
      html += 'let currentAudio = null;'
      html += 'let boardFillPlayed = false;'
      html += 'let soundOn = true;'
      html += 'try { soundOn = localStorage.getItem("jeopardy-sound") !== "off"; } catch (e) {}'
      html += 'const defaultNames = ["Player 1","Player 2","Player 3"];'
      html += 'let names = defaultNames.slice();'
      html += 'try { const saved = JSON.parse(localStorage.getItem("jeopardy-names")); if (Array.isArray(saved) && saved.length === 3) names = saved.map(function(n,i) { return String(n || defaultNames[i]); }); } catch (e) {}'
      html += 'let scores = [0,0,0];'
      html += 'function fmt(n) { return (n < 0 ? "-$" : "$") + Math.abs(n); }'
      html += 'function renderScores() {'
      html += 'scoresEl.querySelectorAll(".jeopardy-player").forEach(function(el, i) {'
      html += 'el.querySelector(".jeopardy-player-name").textContent = names[i];'
      html += 'el.querySelector(".jeopardy-player-score").textContent = fmt(scores[i]);'
      html += '});'
      html += '}'
      html += 'function saveNames() { try { localStorage.setItem("jeopardy-names", JSON.stringify(names)); } catch (e) {} }'
      html += 'function setSound(on) { soundOn = on; try { localStorage.setItem("jeopardy-sound", on ? "on" : "off"); } catch (e) {} soundBtn.textContent = on ? "🔊" : "🔇"; soundBtn.title = on ? "Sound on" : "Sound off"; if (!on) stopSound(); }'
      html += 'function stopSound() { if (currentAudio) { currentAudio.pause(); currentAudio.currentTime = 0; currentAudio = null; } }'
      html += 'function playSound(name, then) { stopSound(); if (!soundOn) { if (then) then(); return; } var audio = new Audio(sounds[name]); currentAudio = audio; audio.addEventListener("ended", function() { if (currentAudio === audio) currentAudio = null; if (then) then(); }); var p = audio.play(); if (p && p.catch) p.catch(function() { if (then) then(); }); }'
      html += 'function playBoardFillIfNeeded(then) { if (boardFillPlayed) { if (then) then(); return; } boardFillPlayed = true; playSound("boardFill", then); }'
      html += 'function startClueSounds(isDD) { playBoardFillIfNeeded(function() { if (isDD) playSound("dailyDouble", function() { playSound("think"); }); else playSound("think"); }); }'
      html += 'function tryAutoBoardFill() { if (!soundOn) return; var audio = new Audio(sounds.boardFill); currentAudio = audio; var p = audio.play(); if (p && p.then) p.then(function() { boardFillPlayed = true; audio.addEventListener("ended", function() { if (currentAudio === audio) currentAudio = null; }); }).catch(function() { currentAudio = null; boardFillPlayed = false; }); }'
      html += 'setSound(soundOn);'
      html += 'renderScores();'
      html += 'scoresEl.querySelectorAll(".jeopardy-player-name").forEach(function(el, i) {'
      html += 'el.addEventListener("input", function() { names[i] = el.textContent.trim() || defaultNames[i]; saveNames(); });'
      html += 'el.addEventListener("blur", function() { if (!el.textContent.trim()) { el.textContent = defaultNames[i]; names[i] = defaultNames[i]; saveNames(); } });'
      html += '});'
      html += 'soundBtn.addEventListener("click", function(e) { e.stopPropagation(); setSound(!soundOn); });'
      html += 'const playable = Array.prototype.slice.call(board.querySelectorAll(".jeopardy-tile:not(.answered)"));'
      html += 'if (playable.length) playable[Math.floor(Math.random() * playable.length)].dataset.dailyDouble = "1";'
      html += 'function scorePlayer(i, ok) { var value = Number(currentTile.dataset.value || 0); scores[i] += ok ? value : -value; renderScores(); playSound(ok ? "correct" : "timesUp"); modal.classList.remove("active"); currentTile.classList.add("answered"); currentTile = null; showingAnswer = false; actionsEl.classList.remove("active"); ddEl.style.display = "none"; }'
      html += 'function fillActions() { actionsEl.innerHTML = ""; names.forEach(function(name, i) { var wrap = document.createElement("div"); wrap.className = "jeopardy-score-player"; wrap.innerHTML = "<span class=\\"jsb-name\\">" + name.replace(/&/g,"&amp;").replace(/</g,"&lt;") + "</span><button type=\\"button\\" data-ok=\\"1\\">✓</button><button type=\\"button\\" data-ok=\\"0\\">✗</button>"; wrap.addEventListener("click", function(e) { e.stopPropagation(); var btn = e.target.closest("button"); if (!btn) return; scorePlayer(i, btn.getAttribute("data-ok") === "1"); }); actionsEl.appendChild(wrap); }); }'
      html += 'board.querySelectorAll(".jeopardy-tile").forEach(function(tile) {'
      html += 'tile.addEventListener("click", function() {'
      html += 'if (tile.classList.contains("answered")) return;'
      html += 'currentTile = tile;'
      html += 'var isDD = tile.dataset.dailyDouble === "1";'
      html += 'ddEl.style.display = isDD ? "block" : "none";'
      html += 'clueEl.textContent = tile.dataset.question;'
      html += 'actionsEl.classList.remove("active");'
      html += 'modal.classList.add("active");'
      html += 'showingAnswer = false;'
      html += 'startClueSounds(isDD);'
      html += '});'
      html += '});'
      html += 'modal.addEventListener("click", function() {'
      html += 'if (!currentTile) return;'
      html += 'if (!showingAnswer) {'
      html += 'stopSound();'
      html += 'clueEl.textContent = currentTile.dataset.answer;'
      html += 'fillActions();'
      html += 'actionsEl.classList.add("active");'
      html += 'showingAnswer = true;'
      html += '}'
      html += '});'
      html += 'tryAutoBoardFill();'
      html += '})();'
      html += '</' + 'script>'
      return html
    }

